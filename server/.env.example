# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Generative AI Credentials (Server-side only, never committed)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Atlas Database Connection
# Target database name: pathforge_ai
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pathforge_ai?retryWrites=true&w=majority

# JWT Authentication Session Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
